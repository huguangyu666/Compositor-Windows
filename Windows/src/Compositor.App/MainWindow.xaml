                        Height="26" Margin="8,0,8,14" Padding="11,0,8,0" CornerRadius="13"
                        Background="#BF000000" BorderBrush="#24FFFFFF" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Grid Width="12" Height="10"><Rectangle Stroke="White" /><Ellipse Width="4" Height="4" Fill="White" /></Grid>
                        <TextBlock x:Uid="L_MaskAloneTitle" Text="Layer Mask" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="MaskAloneName" Foreground="#99FFFFFF" FontSize="12" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Button x:Name="MaskAloneCloseButton" Click="OnCloseMaskAlone" MinWidth="0" MinHeight="0" Width="20" Height="22"
                                Padding="0" BorderThickness="0" Background="Transparent" Foreground="White">
                            <FontIcon Glyph="&#xE711;" FontSize="9" />
                        </Button>
                    </StackPanel>
                </Border>
                </Grid>
                </local:ViewportSurface>
            </ScrollViewer>
            <Grid x:Name="AiPreviewHost" Grid.Row="1" Grid.Column="1" Background="#FF1B1B1B" Visibility="Collapsed" IsHitTestVisible="False">
                <Image x:Name="AiPreviewImage" Stretch="Uniform" Margin="24" />
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#E5282828" CornerRadius="4" Padding="8,4" Margin="12">
                    <TextBlock x:Uid="L_AiPreview" Text="AI preview · not yet applied" />
                </Border>
            </Grid>
            <Grid x:Name="AiWorkingHost" Grid.Row="1" Grid.Column="1" Visibility="Collapsed" IsHitTestVisible="False">
                <Border x:Name="AiWorkingRegion" HorizontalAlignment="Left" VerticalAlignment="Top" BorderThickness="2"
                        Background="#0C8B5CF6" CornerRadius="4">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#AA67E8F9" Offset="0" />
                            <GradientStop Color="#DDD8B4FE" Offset="0.5" />
                            <GradientStop Color="#AA818CF8" Offset="1" />
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Grid>
                        <Grid.Clip><RectangleGeometry x:Name="AiWorkingClip" /></Grid.Clip>
                        <Rectangle x:Name="AiWorkingScan" Width="180" HorizontalAlignment="Left">
                            <Rectangle.RenderTransform><TranslateTransform x:Name="AiWorkingScanShift" /></Rectangle.RenderTransform>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#0067E8F9" Offset="0" />
                                    <GradientStop Color="#1867E8F9" Offset="0.3" />
                                    <GradientStop Color="#558B5CF6" Offset="0.6" />
                                    <GradientStop Color="#00C4B5FD" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>
                </Border>
                <Border x:Name="AiWorkingBadge" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#ED211C32"
                        BorderBrush="#806F69AB" BorderThickness="1" CornerRadius="14" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="✦" Foreground="#FFC4B5FD" />
                        <TextBlock x:Uid="L_AiWorking" Text="AI is creating…" Foreground="#FFF3EEFF" FontSize="12" />
                    </StackPanel>
                </Border>
            </Grid>
            <Border x:Name="AiActions" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Visibility="Collapsed" Background="#F52D2D2D" BorderBrush="#FF555555" BorderThickness="1" CornerRadius="6" Padding="4">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button x:Name="AiRemoveButton" x:Uid="B_AiRemove" Content="AI Remove" Click="OnAiRemove" Padding="10,5" />
                    <Button x:Name="AiReplaceButton" x:Uid="B_AiReplace" Content="Replace" Click="OnAiReplace" Padding="10,5" />
                    <Button x:Uid="B_AiExpand" Content="Expand" Click="OnAiExpand" Padding="10,5" />
                </StackPanel>
            </Border>
            </Grid>
            </Grid>

            <local:WorkspaceResizeEdge Grid.Column="2" x:Name="PanelResizeEdge" Background="#FF393939"
                    PointerPressed="OnPanelResizePressed" PointerMoved="OnPanelResizeMoved"
                    PointerReleased="OnPanelResizeReleased" PointerCanceled="OnPanelResizeReleased"
                    PointerCaptureLost="OnPanelResizeReleased" x:Uid="W_PanelResize" />

            <Grid Grid.Column="3" x:Name="LayersPane" Background="#FF252525">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="LayersHeader" Padding="12,10" BorderBrush="#FF393939" BorderThickness="0,0,0,1">
                    <TextBlock x:Uid="L_Layers" Text="Layers" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock x:Name="LayerCountLabel" HorizontalAlignment="Right" FontSize="12" Opacity="0.55" />
                </Grid>
                <StackPanel x:Name="LayerAppearance" Grid.Row="1" Spacing="8" Padding="12,10" BorderBrush="#FF393939" BorderThickness="0,0,0,1">
                    <TextBlock x:Name="SelectedLayerName" Text="No layer selected" Visibility="Collapsed" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="BlendLabel" x:Uid="L_Blend" Text="Blend" VerticalAlignment="Center" FontSize="12" />
                        <ComboBox x:Name="BlendCombo" Grid.Column="1" HorizontalAlignment="Stretch"
                                  AutomationProperties.LabeledBy="{x:Bind BlendLabel}" SelectionChanged="OnBlendChanged" />
                    </Grid>
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="74" /></Grid.ColumnDefinitions>
                        <local:ViewportSurface x:Name="LayerOpacityScrub" VerticalAlignment="Center" IsTabStop="False">
                            <TextBlock x:Name="LayerOpacityLabel" x:Uid="L_Opacity" Text="Opacity" FontSize="12" />
                        </local:ViewportSurface>
                        <Slider x:Name="OpacitySlider" Grid.Column="1" MinWidth="0" Minimum="0" Maximum="100"
                                AutomationProperties.LabeledBy="{x:Bind LayerOpacityLabel}"
                                ValueChanged="OnOpacityChanged" PointerCaptureLost="OnOpacityCommit" />
                        <NumberBox x:Name="OpacityBox" Grid.Column="2" MinWidth="0" Minimum="0" Maximum="100" Value="100"
                                   AutomationProperties.LabeledBy="{x:Bind LayerOpacityLabel}"
                                   SpinButtonPlacementMode="Hidden" ValueChanged="OnOpacityBoxChanged" />
                    </Grid>
                    <TextBlock x:Name="OpacityLabel" Visibility="Collapsed" />
                    <CheckBox x:Name="VisibleCheck" x:Uid="L_Visible" Content="Visible" Visibility="Collapsed" Checked="OnVisibleChanged" Unchecked="OnVisibleChanged" />
                </StackPanel>

                <ListView x:Name="LayerList" Grid.Row="2" SelectionMode="Extended" SelectionChanged="OnLayerSelected"
                          CanDragItems="True" AllowDrop="True"
                          PointerMoved="OnLayerGesturePointerMoved" PointerReleased="OnLayerGesturePointerReleased"
                          PointerCaptureLost="OnLayerGesturePointerCaptureLost" PointerCanceled="OnLayerGesturePointerCaptureLost"
                          DragItemsStarting="OnLayerRowsDragItemsStarting" DragItemsCompleted="OnLayerRowsDragItemsCompleted"
                          DragOver="OnLayerRowsDragOver" DragLeave="OnLayerRowsDragLeave" Drop="OnLayerRowsDrop">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="8,4" />
                            <Setter Property="MinHeight" Value="40" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <!-- The Mac draws the drop decision itself (tableView.setDropRow, NativeLayerList.swift
                     :406): an insertion line where a plain row lands above, and the row's own band
                     highlighted when the drop goes INTO a folder. The decision has lived here since the
                     placement work; this canvas is only its picture - transparent to hits, so the list
                     keeps every gesture. -->
                <Canvas x:Name="LayerDropFeedback" Grid.Row="2" IsHitTestVisible="False">
                    <Border x:Name="DropInsertionLine" Height="2" Background="#FF609EFF" Visibility="Collapsed" />
                    <Border x:Name="DropFolderBand" Background="#4D609EFF" BorderBrush="#FF609EFF"
                            BorderThickness="1" Visibility="Collapsed" />
                </Canvas>

                <ScrollViewer x:Name="LayerPropertiesScroll" Grid.Row="3" MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="AdjustmentPanel" Spacing="8" Margin="12,8" Visibility="Collapsed" />
                </ScrollViewer>

                <StackPanel Grid.Row="4" x:Name="LayerCommands" Orientation="Horizontal" Padding="8,3" BorderBrush="#FF393939" BorderThickness="0,1,0,0">
                    <Button x:Name="BlankWorkspaceButton" x:Uid="W_NewBlankLayer" Style="{StaticResource WorkspaceIconButton}" Click="OnAddBlankLayer"><FontIcon Glyph="&#xE710;" FontSize="15" /></Button>
                    <Button x:Uid="W_Folder" Style="{StaticResource WorkspaceIconButton}" Click="OnAddFolder"><FontIcon Glyph="&#xE8F4;" FontSize="15" /></Button>
                    <Button x:Name="MaskWorkspaceButton" x:Uid="W_Mask" Style="{StaticResource WorkspaceIconButton}" Click="OnAddWorkspaceMask">
                        <Grid Width="16" Height="14"><Rectangle Stroke="#FFE2E2E2" /><Ellipse Width="6" Height="6" Fill="#FFE2E2E2" /></Grid>
                    </Button>
                    <Button x:Uid="W_Effects" Style="{StaticResource WorkspaceIconButton}" Click="OnLayerEffects" Content="fx" FontSize="13" FontStyle="Italic" />
                    <Button x:Uid="W_Adjustment" Style="{StaticResource WorkspaceIconButton}" x:Name="AdjustmentMenuButton">
                        <Grid Width="16" Height="16"><Ellipse Stroke="#FFE2E2E2" /><Path Data="M8,0 A8,8 0 0 0 8,16 Z" Fill="#FFE2E2E2" /></Grid>
                        <Button.Flyout><MenuFlyout x:Name="FooterAdjustmentMenu" /></Button.Flyout>
                    </Button>
                    <Button x:Uid="W_MoreLayers" Style="{StaticResource WorkspaceIconButton}">
                        <FontIcon Glyph="&#xE712;" FontSize="15" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Uid="M_Raise" Text="Raise" Click="OnRaiseLayer" />
                                <MenuFlyoutItem x:Uid="M_Lower" Text="Lower" Click="OnLowerLayer" />
                                <MenuFlyoutItem x:Uid="M_Duplicate" Text="Duplicate Layers" Click="OnDuplicateLayers" />
                                <MenuFlyoutItem x:Uid="M_Rename" Text="Rename Layer…" Click="OnRenameLayer" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Uid="W_DeleteLayer" Style="{StaticResource WorkspaceIconButton}" Click="OnDeleteLayer"><FontIcon Glyph="&#xE74D;" FontSize="15" /></Button>
                </StackPanel>
            </Grid>

            <!-- #37: the window's non-modal panel host, the counterpart of the Mac's FloatingPanelController.
                 Panels are built in code and dropped in here, so several can be up at once as they are on the
                 Mac (effects beside the color picker beside the filter). The container deliberately carries no
                 Background: an unset brush makes it transparent to the pointer, so an empty host never eats a
                 canvas click. -->
            <Grid x:Name="FloatingPanelHosts" Grid.Column="1" />
            <!-- Docked panels (Camera Raw, the way the Mac parks it) span every column, because the original
                 copies its frame from the document window's right edge and 440 px covers the layers pane;
                 FloatingPanelHosts is the canvas column alone and would park the panel to the left of it.
                 Last child, so it paints above the pane it covers, and it carries no Background so an empty
                 host stays transparent to the pointer. -->
            <Grid x:Name="DockedPanelHosts" Grid.Column="0" Grid.ColumnSpan="4" />
        </Grid>

        <Border x:Name="TimelineHost" Grid.Row="4" Visibility="Collapsed" Background="#FF242424" BorderBrush="#FF414141" BorderThickness="0,1,0,0" />
        <Grid Grid.Row="5" Padding="12,4" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ZoomLabel" Text="100%" VerticalAlignment="Center" FontSize="11" Opacity="0.9" MinWidth="44" />
            <TextBlock x:Name="DocSizeLabel" Grid.Column="1" VerticalAlignment="Center" FontSize="11" Opacity="0.7" />
            <ProgressBar x:Name="StatusProgress" Grid.Column="2" Width="120" Height="4" IsIndeterminate="True"
                         VerticalAlignment="Center" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" Grid.Column="3" Text="Ready" FontSize="12" Opacity="0.85" TextTrimming="CharacterEllipsis" />
            <HyperlinkButton x:Name="ErrorDetailsButton" Grid.Column="4" x:Uid="L_Details" Content="Details" Padding="0"
                             FontSize="12" Click="OnErrorDetails" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
