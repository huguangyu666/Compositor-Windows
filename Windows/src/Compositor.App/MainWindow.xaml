<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Compositor.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:local="using:Compositor.App"
    Title="Compositor">

    <!-- The Mac pins dark mode for the whole app (NSApp.appearance = darkAqua), so the
         port does too — at the application level, so flyouts and dialogs follow, with a
         solid dark chrome color behind the theme's light text. The canvas and its overlays
         keep their own fixed accent colors. The plain X and D keys swap and reset the
         palette, as the macOS canvas does. -->
    <Grid x:Name="RootGrid" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
          RequestedTheme="Dark" Background="#FF1E1E1E">
        <Grid.Resources>
            <Style x:Key="ToolbarNavigationStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
            <Style x:Key="SelectionModeButtonStyle" TargetType="ToggleButton">
                <Setter Property="MinWidth" Value="64" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="10,3" />
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </Grid.Resources>
        <Grid.KeyboardAccelerators>
            <!-- Named because a rebind rewrites the chord on the very object that carries its handler. -->
            <KeyboardAccelerator x:Name="SwapColorsAccelerator" Key="X" Invoked="OnSwapColorsAccelerator" />
            <KeyboardAccelerator x:Name="ResetColorsAccelerator" Key="D" Invoked="OnResetColorsAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <MenuBar x:Name="MenuBarRoot" Grid.Row="0">
            <MenuBarItem x:Uid="M_File" Title="File">
                <MenuFlyoutItem x:Name="NewProjectMenuItem" x:Uid="M_New" Text="New" Click="OnNew">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="N" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="OpenProjectMenuItem" x:Uid="M_Open" Text="Open Source…" Click="OnOpen">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="O" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="OpenProjectFolderMenuItem" x:Uid="M_OpenProjectFolder" Text="Open Project Folder…" Click="OnOpenProjectFolder">
                    <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control, Shift" Key="O" /></MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSubItem x:Uid="M_OpenRecent" x:Name="OpenRecentMenu" Text="Open Recent">
                    <MenuFlyoutItem x:Name="ClearRecentMenuItem" x:Uid="M_ClearMenu" Text="Clear Menu" Click="OnClearRecentProjects" />
                </MenuFlyoutSubItem>
                <MenuFlyoutItem x:Name="SaveMenuItem" x:Uid="M_Save" Text="Save" Click="OnSave">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="S" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="SaveAsMenuItem" x:Uid="M_SaveAs" Text="Save As…" Click="OnSaveAs">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control, Shift" Key="S" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="ImportMenuItem" x:Uid="M_Import" Text="Import Image…" Click="OnImportImage">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="I" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="M_ImageSize" Text="Image Size…" Click="OnImageSize" />
                <MenuFlyoutItem x:Uid="M_CanvasSize" Text="Canvas Size…" Click="OnCanvasSize" />
                <MenuFlyoutItem x:Uid="M_Trim" Text="Trim…" Click="OnTrim" />
                <MenuFlyoutItem x:Uid="M_FlipCanvasHorizontal" Text="Flip Canvas Horizontal" Click="OnFlipCanvasHorizontal" />
                <MenuFlyoutItem x:Uid="M_FlipCanvasVertical" Text="Flip Canvas Vertical" Click="OnFlipCanvasVertical" />
                <MenuFlyoutItem x:Uid="M_ExportPng" Text="Export PNG…" Click="OnExportPng" />
                <MenuFlyoutItem x:Uid="M_ExportJpeg" Text="Export JPEG…" Click="OnExportJpeg" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="CloseProjectMenuItem" x:Uid="M_CloseProject" Text="Close Project" Click="OnCloseProject">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="W" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="M_Exit" Text="Exit" Click="OnExit" />
            </MenuBarItem>
            <MenuBarItem x:Name="EditMenu" x:Uid="M_Edit" Title="Edit">
                <MenuFlyoutItem x:Name="UndoMenuItem" x:Uid="M_Undo" Text="Undo" Click="OnUndo">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Z" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="RedoMenuItem" x:Uid="M_Redo" Text="Redo" Click="OnRedo">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Y" />
                        <KeyboardAccelerator Modifiers="Control, Shift" Key="Z" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="FreeTransformMenuItem" x:Uid="Tr_FreeTransform" Text="Free Transform" Click="OnFreeTransform">
                    <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="T" /></MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="CopyPixelsMenuItem" x:Uid="M_CopyPixels" Text="Copy" Click="OnCopyPixels" ToolTipService.ToolTip="Ctrl+C">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="C" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="CutPixelsMenuItem" x:Uid="M_CutPixels" Text="Cut" Click="OnCutPixels" ToolTipService.ToolTip="Ctrl+X">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="X" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="PastePixelsMenuItem" x:Uid="M_PastePixels" Text="Paste" Click="OnPastePixels" ToolTipService.ToolTip="Ctrl+V">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="V" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="LayerViaCopyMenuItem" x:Uid="M_LayerViaCopy" Text="Layer via Copy" Click="OnLayerViaCopy" ToolTipService.ToolTip="Ctrl+J">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="J" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="CopyMergedMenuItem" x:Uid="M_CopyMerged" Text="Copy Merged" Click="OnCopyMerged" ToolTipService.ToolTip="Ctrl+Shift+C">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="C" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="SelectAllMenuItem" x:Uid="M_SelectAll" Text="Select All" Click="OnSelectAll" ToolTipService.ToolTip="Ctrl+A">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="A" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="InvertSelectionMenuItem" x:Uid="M_InvertSelection" Text="Inverse Selection" Click="OnInvertSelection" ToolTipService.ToolTip="Ctrl+Shift+I">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="I" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="DeselectMenuItem" x:Uid="M_Deselect" Text="Deselect" Click="OnDeselect">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="D" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="LoadLayerPixelsMenuItem" x:Uid="M_LoadLayerPixels" Text="Layer's Pixels" Click="OnLoadLayerPixels" />
                <MenuFlyoutItem x:Name="LoadMaskBlackMenuItem" x:Uid="M_LoadMaskBlack" Text="Mask's Black Areas" Click="OnLoadMaskBlack" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="M_ExpandSelection" Text="Expand Selection" Click="OnExpandSelection" />
                <MenuFlyoutItem x:Uid="M_ContractSelection" Text="Contract Selection" Click="OnContractSelection" />
                <MenuFlyoutItem x:Uid="M_FeatherSelection" Text="Feather Selection" Click="OnFeatherSelection" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="M_ColorRange" Text="Color Range…" Click="OnColorRange" />
                <MenuFlyoutItem x:Uid="M_InvertPixels" Text="Invert Pixels" Click="OnInvertPixels" />
                <MenuFlyoutItem x:Uid="M_InvertMask" Text="Invert Mask" Click="OnInvertMask" />
                <MenuFlyoutItem x:Name="FillForegroundMenuItem" x:Uid="M_FillForeground" Text="Fill With Foreground" Click="OnFillForeground">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Shift" Key="F5" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="M_FillBackground" Text="Fill With Background" Click="OnFillBackground" />
                <MenuFlyoutItem x:Uid="M_ClearSelection" Text="Clear Selection Pixels" Click="OnClearSelectionPixels" />
                <MenuFlyoutItem x:Uid="M_ContentFill" Text="Content-Aware Fill" Click="OnContentFill" />
                <MenuFlyoutItem x:Uid="M_Dither" Text="Dither…" Click="OnDither" />
                <MenuFlyoutItem x:Uid="M_Distort" Text="Free Distort…" Click="OnDistort" />
                <MenuFlyoutItem x:Uid="M_LensCorrection" Text="Lens Correction…" Click="OnLensCorrection" />
                <MenuFlyoutItem x:Uid="M_Vignette" Text="Vignette…" Click="OnVignette" />
                <MenuFlyoutItem x:Uid="M_TonalContrast" Text="Tonal Contrast…" Click="OnTonalContrast" />
                <MenuFlyoutItem x:Uid="M_GaussianBlurFilter" Text="Gaussian Blur…" Click="OnGaussianBlurFilter" />
                <MenuFlyoutItem x:Uid="M_MotionBlurFilter" Text="Motion Blur…" Click="OnMotionBlurFilter" />
                <MenuFlyoutItem x:Uid="M_BloomFilter" Text="Bloom / Glow…" Click="OnBloomFilter" />
                <MenuFlyoutItem x:Uid="M_AddNoiseFilter" Text="Add Noise…" Click="OnAddNoiseFilter" />
                <MenuFlyoutItem x:Name="CameraRawFilterMenuItem" x:Uid="M_CameraRawFilter"
                                Text="Camera Raw Filter…" Click="OnCameraRawFilter" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="M_SelectSubject" Text="Select Subject (AI)" Click="OnSelectSubject" />
                <MenuFlyoutItem x:Uid="M_RemoveSubject" Text="Remove Subject (AI)" Click="OnRemoveSubject" />
            </MenuBarItem>
            <MenuBarItem x:Uid="M_Ai" Title="AI">
                <MenuFlyoutItem x:Uid="M_AiRemove" Text="Remove…" Click="OnAiRemove" />
                <MenuFlyoutItem x:Uid="M_AiReplace" Text="Replace…" Click="OnAiReplace" />
                <MenuFlyoutItem x:Uid="M_AiExpand" Text="Expand Canvas…" Click="OnAiExpand" />
            </MenuBarItem>
            <MenuBarItem x:Name="LayerMenu" x:Uid="M_Layer" Title="Layer">
                <MenuFlyoutItem x:Name="NewBlankLayerMenuItem" x:Uid="M_NewBlankLayer" Text="New Blank Layer" Click="OnAddBlankLayer">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control, Shift" Key="N" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="M_AddFolder" Text="Add Folder" Click="OnAddFolder" />
                <MenuFlyoutItem x:Name="GroupMenuItem" x:Uid="M_Group" Text="New Group from Selection" Click="OnGroupLayers">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="G" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="UngroupMenuItem" x:Uid="M_Ungroup" Text="Ungroup" Click="OnUngroupLayer">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control, Shift" Key="G" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="MergeMenuItem" x:Uid="M_Merge" Text="Merge Layers" Click="OnMergeLayers" />
                <MenuFlyoutItem x:Uid="M_Duplicate" Text="Duplicate Layers" Click="OnDuplicateLayers" />
                <MenuFlyoutItem x:Uid="M_FlipLayerHorizontal" Text="Flip Layer Horizontal" Click="OnFlipLayerHorizontal" />
                <MenuFlyoutItem x:Uid="M_FlipLayerVertical" Text="Flip Layer Vertical" Click="OnFlipLayerVertical" />
                <MenuFlyoutItem x:Uid="M_MoveOut" Text="Move Out of Folder" Click="OnMoveOutOfFolder" />
                <MenuFlyoutItem x:Name="RenameMenuItem" x:Uid="M_Rename" Text="Rename Layer…" Click="OnRenameLayer" />
                <MenuFlyoutSubItem x:Uid="M_AddAdjustment" Text="Add Adjustment">
                    <MenuFlyoutItem x:Uid="M_Invert" Text="Invert" Tag="Invert" Click="OnAddAdjustment" />
                    <MenuFlyoutItem x:Uid="M_Exposure" Text="Exposure" Tag="Exposure" Click="OnAddAdjustment" />
                    <MenuFlyoutItem x:Uid="M_HueSat" Text="Hue/Saturation" Tag="HueSaturation" Click="OnAddAdjustment" />
                    <MenuFlyoutItem x:Uid="M_Levels" Text="Levels" Tag="Levels" Click="OnAddAdjustment" />
                    <MenuFlyoutItem x:Uid="M_Curves" Text="Curves" Tag="Curves" Click="OnAddAdjustment" />
                    <MenuFlyoutItem x:Uid="M_ColorBalance" Text="Color Balance" Tag="ColorBalance" Click="OnAddAdjustment" />
                    <MenuFlyoutItem x:Uid="M_BlackWhite" Text="Black &amp; White" Tag="BlackWhite" Click="OnAddAdjustment" />
                    <MenuFlyoutItem x:Uid="M_GradientMap" Text="Gradient Map" Tag="GradientMap" Click="OnAddAdjustment" />
                    <MenuFlyoutItem x:Uid="M_Grain" Text="Grain" Tag="Grain" Click="OnAddAdjustment" />
                    <MenuFlyoutItem x:Uid="M_GaussianBlur" Text="Gaussian Blur" Tag="GaussianBlur" Click="OnAddAdjustment" />
                    <MenuFlyoutItem x:Uid="M_MotionBlur" Text="Motion Blur" Tag="MotionBlur" Click="OnAddAdjustment" />
                    <MenuFlyoutItem x:Uid="M_AddNoise" Text="Add Noise" Tag="AddNoise" Click="OnAddAdjustment" />
                </MenuFlyoutSubItem>
                <MenuFlyoutItem x:Name="EditAdjustmentMenuItem" x:Uid="M_EditAdjustment" Text="Edit Adjustment…" Click="OnEditAdjustment" />
                <MenuFlyoutItem x:Uid="M_LayerEffects" Text="Layer Effects…" Click="OnLayerEffects" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="AddMaskMenuItem" x:Uid="M_AddMask" Text="Add Reveal Mask" Click="OnAddMask" />
                <MenuFlyoutItem x:Name="AddHideAllMaskMenuItem" x:Uid="M_AddHideAllMask" Text="Add Hide-All Mask" Click="OnAddHideAllMask" />
                <MenuFlyoutItem x:Name="RevealSelectionMaskMenuItem" x:Uid="M_RevealSelectionMask" Text="Reveal Selection" Click="OnRevealSelectionMask" />
                <MenuFlyoutItem x:Name="HideSelectionMaskMenuItem" x:Uid="M_HideSelectionMask" Text="Hide Selection" Click="OnHideSelectionMask" />
                <MenuFlyoutItem x:Name="MaskLinkMenuItem" x:Uid="M_MaskLink" Text="Unlink Mask" Click="OnToggleMaskLink" />
                <MenuFlyoutItem x:Name="MaskEnabledMenuItem" x:Uid="M_MaskEnabled" Text="Disable Mask" Click="OnToggleMaskEnabled" />
                <MenuFlyoutItem x:Name="ClippingMaskMenuItem" x:Uid="M_ClippingMask" Text="Create Clipping Mask" Click="OnToggleClippingMask" />
                <MenuFlyoutItem x:Uid="M_RemoveMask" Text="Remove Mask" Click="OnRemoveMask" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="RaiseMenuItem" x:Uid="M_Raise" Text="Raise" Click="OnRaiseLayer" />
                <MenuFlyoutItem x:Name="LowerMenuItem" x:Uid="M_Lower" Text="Lower" Click="OnLowerLayer" />
                <MenuFlyoutItem x:Uid="M_Delete" Text="Delete" Click="OnDeleteLayer" />
            </MenuBarItem>
            <MenuBarItem x:Uid="M_View" Title="View">
                <ToggleMenuFlyoutItem x:Name="TimelineToggle" x:Uid="TL_Menu" Text="Timeline" Click="OnToggleTimeline" />
                <MenuFlyoutItem x:Name="FitCanvasMenuItem" x:Uid="M_Fit" Text="Fit to Window" Click="OnFitToWindow" ToolTipService.ToolTip="Fit the whole canvas (Ctrl+0)">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Number0" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="Zoom100MenuItem" x:Uid="M_Zoom100" Text="Zoom 100%" Click="OnZoom100" ToolTipService.ToolTip="Actual size (Ctrl+1)">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Number1" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="ZoomInItem" x:Uid="M_ZoomIn" Text="Zoom In" Click="OnZoomIn" ToolTipService.ToolTip="Ctrl+= / Ctrl++">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Add" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="ZoomOutItem" x:Uid="M_ZoomOut" Text="Zoom Out" Click="OnZoomOut" ToolTipService.ToolTip="Ctrl+-">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Subtract" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <ToggleMenuFlyoutItem x:Name="PixelGridToggle" x:Uid="V_ShowGrid" Text="Show Pixel Grid" Click="OnShowPixelGrid" ToolTipService.ToolTip="Visible from 800%" />
                <ToggleMenuFlyoutItem x:Name="McpAnimationToggle" x:Uid="V_McpAnimation" Text="AI Operation Animation" IsChecked="True" Click="OnToggleMcpAnimation" />
                <ToggleMenuFlyoutItem x:Name="GpuRenderingToggle" x:Uid="V_GpuRendering" Text="GPU Acceleration (Automatic Fallback)" IsChecked="True" Click="OnToggleGpuRendering" />
                <ToggleMenuFlyoutItem x:Name="RulersToggle" x:Uid="N_Rulers" Text="Show Rulers" Click="OnShowRulers">
                    <ToggleMenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="R" Modifiers="Control" /></ToggleMenuFlyoutItem.KeyboardAccelerators>
                </ToggleMenuFlyoutItem>
                <ToggleMenuFlyoutItem x:Name="GridToggle" x:Uid="V_Grid" Text="Grid" Click="OnToggleShowGrid" />
                <MenuFlyoutItem x:Name="GridSettingsButton" x:Uid="V_GridSettings" Text="Grid Settings…" Click="OnGridSettings" />
                <ToggleMenuFlyoutItem x:Name="GuidesToggle" x:Uid="V_ShowGuides" Text="Guides" Click="OnToggleGuides" />
                <ToggleMenuFlyoutItem x:Name="SnapToggle" x:Uid="V_Snap" Text="Snap" Click="OnToggleSnap" />
                <MenuFlyoutSubItem x:Uid="V_SnapTo" Text="Snap To">
                    <ToggleMenuFlyoutItem x:Name="SnapToGuidesToggle" x:Uid="V_SnapToGuides" Text="Guides" Click="OnToggleSnapToGuides" />
                    <ToggleMenuFlyoutItem x:Name="SnapToGridToggle" x:Uid="V_SnapToGrid" Text="Grid" Click="OnToggleSnapToGrid" />
                    <ToggleMenuFlyoutItem x:Name="SnapToLayersToggle" x:Uid="V_SnapToLayers" Text="Layers" Click="OnToggleSnapToLayers" />
                    <ToggleMenuFlyoutItem x:Name="SnapToBoundsToggle" x:Uid="V_SnapToBounds" Text="Document Bounds" Click="OnToggleSnapToBounds" />
                </MenuFlyoutSubItem>
                <ToggleMenuFlyoutItem x:Name="LockGuidesToggle" x:Uid="V_LockGuides" Text="Lock Guides" Click="OnToggleLockGuides" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="M_GuideV" Text="Add Vertical Guide" Click="OnAddVerticalGuide" />
                <MenuFlyoutItem x:Uid="M_GuideH" Text="Add Horizontal Guide" Click="OnAddHorizontalGuide" />
                <MenuFlyoutItem x:Uid="M_GuidesClear" Text="Clear Guides" Click="OnClearGuides" />
            </MenuBarItem>
            <MenuBarItem x:Uid="M_Help" Title="Help">
                <MenuFlyoutItem x:Uid="M_Shortcuts" Text="Keyboard Shortcuts" Click="ShowShortcutEditor" />
            </MenuBarItem>
        </MenuBar>
        <Border Grid.Row="1" Background="#FF252525" BorderBrush="#FF393939" BorderThickness="0,0,0,1">
            <Grid Height="40" Padding="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Uid="W_New" Content="+" Width="32" Height="30" Padding="0" Click="OnNew" />
                <StackPanel x:Name="ProjectTabStrip" Grid.Column="1" Orientation="Horizontal" Spacing="4"
                            VerticalAlignment="Center" Margin="10,0" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button x:Uid="W_Fit" Content="Fit" Click="OnFitToWindow" Height="30" Padding="10,0" />
                    <Button Content="100%" Click="OnZoom100" Height="30" Padding="10,0" ToolTipService.ToolTip="100% (Ctrl+1)" />
                    <Button x:Name="ZoomOutButton" x:Uid="W_ZoomOut" Click="OnZoomOut" Height="30" Width="30" Padding="0">
                        <FontIcon Glyph="&#xE71F;" FontSize="14" />
                    </Button>
                    <Button x:Name="ZoomInButton" x:Uid="W_ZoomIn" Click="OnZoomIn" Height="30" Width="30" Padding="0">
                        <FontIcon Glyph="&#xE8A3;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" x:Name="ToolHeader" Background="#FF292929" BorderBrush="#FF393939" BorderThickness="0,0,0,1">
            <Grid Height="58" Padding="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ActiveToolLabel" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="100" TextTrimming="CharacterEllipsis" />
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ToolOptionsPreviousButton" Width="26" Style="{StaticResource ToolbarNavigationStyle}" Content="‹" FontSize="22"
                            VerticalAlignment="Center" Visibility="Collapsed" Click="OnToolOptionsPrevious" />
                <ScrollViewer x:Name="ToolOptionsScroll" Grid.Column="1" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ToolOptionsPanel" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <ComboBox x:Name="ToolCombo" SelectionChanged="OnToolChanged" Visibility="Collapsed" />
                        <StackPanel x:Name="TransformControls" Orientation="Horizontal" Spacing="8" Visibility="Collapsed" />
                        <StackPanel x:Name="NavigationControls" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                            <NumberBox x:Name="NavigationZoomBox" Value="100" Minimum="0.1" Maximum="3200" SmallChange="1" LargeChange="10" Width="96"
                                       ValueChanged="OnNavigationZoomChanged" KeyDown="OnNavigationZoomKey" />
                            <TextBlock Text="%" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel x:Name="EyedropperControls" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                            <ComboBox x:Name="EyedropperTargetCombo" SelectedIndex="0" Width="150">
                                <ComboBoxItem x:Uid="N_Foreground" Content="Foreground" /><ComboBoxItem x:Uid="N_Background" Content="Background" />
                            </ComboBox>
                            <CheckBox x:Name="SampleRingCheck" x:Uid="N_SampleRing" Content="Sample ring" IsChecked="True" />
