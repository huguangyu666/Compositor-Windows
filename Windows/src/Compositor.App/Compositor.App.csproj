<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Compositor.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefaultLanguage>en-US</DefaultLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
  </ItemGroup>

  <!-- The system clipboard is written through the OLE (WinForms) clipboard: WinRT's
       DataPackage broker writes formats other apps fail to read (CLIPBRD_E_BAD_DATA). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Compositor.Core\Compositor.Core.csproj" />
    <ProjectReference Include="..\Compositor.Renderer\Compositor.Renderer.csproj" />
    <ProjectReference Include="..\Compositor.Segmentation\Compositor.Segmentation.csproj" />
    <Content Include="..\..\third-party\MobileSAM-LICENSE.txt" Link="third-party\MobileSAM-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\third-party\SAM2-LICENSE.txt" Link="third-party\SAM2-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\third-party\ONNXRuntime-LICENSE.txt" Link="third-party\ONNXRuntime-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\third-party\ONNXRuntime-ThirdPartyNotices.txt" Link="third-party\ONNXRuntime-ThirdPartyNotices.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\third-party\Segmentation-NOTICE.txt" Link="third-party\Segmentation-NOTICE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\third-party\OpenCV-GrabCut-LICENSE.txt" Link="third-party\OpenCV-GrabCut-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\third-party\CLIProxyAPI-LICENSE.txt" Link="third-party\CLIProxyAPI-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\third-party\Vortice-LICENSE.txt" Link="third-party\Vortice-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Shaders\*.bin" />
  </ItemGroup>

  <!-- ONNX Runtime supplies DirectML as transitive Content. Keep that redistributable
       instead of the SDK's second copy at the same app-local/bundle path. -->
  <Target Name="PreferOnnxDirectMLRuntime" AfterTargets="AddMicrosoftWindowsAppSDKPayloadFilesFromMsix"
          Condition="'$(WindowsAppSDKSelfContained)' == 'true' and '$(MicrosoftWindowsAppSDKMsixContent)' != ''">
    <ItemGroup>
      <None Remove="$(MicrosoftWindowsAppSDKMsixContent)\DirectML.dll" />
    </ItemGroup>
  </Target>

</Project>
