<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Compositor.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Project format, imaging and CPU compositing for Compositor on Windows.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Compositor.Core.Tests" />
    <InternalsVisibleTo Include="Compositor.App" />
    <!-- GDI+ text rasterization (TextRasterizer) draws through System.Drawing, which on
         .NET 9 ships only with the Windows Desktop framework. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

</Project>
