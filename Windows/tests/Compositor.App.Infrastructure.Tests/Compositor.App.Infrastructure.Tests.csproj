<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>Compositor.App.Infrastructure.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- Compile the app's own logging source instead of a copy, so these tests exercise the
       production implementation without activating WinUI. -->
  <ItemGroup>
    <Compile Include="..\..\src\Compositor.App\AppLogging.cs" Link="AppLogging.cs" />
    <Compile Include="..\..\src\Compositor.App\ShortcutChord.cs" Link="ShortcutChord.cs" />
    <Compile Include="..\..\src\Compositor.App\UiLanguage.cs" Link="UiLanguage.cs" />
    <Compile Include="..\..\src\Compositor.App\SvgImport.cs" Link="SvgImport.cs" />
    <Compile Include="..\..\src\Compositor.App\Ai\*.cs" Link="Ai\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
